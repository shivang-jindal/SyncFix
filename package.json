{
  "name": "syncfix",
  "version": "1.0.0",
  "private": true,
  "description": "SyncFix - monitored data synchronization and repair for small teams.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build -w @syncfix/shared",
    "build:server": "npm run build -w @syncfix/server",
    "build:client": "npm run build -w @syncfix/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "typecheck": "npm run build:shared && npm run typecheck -w @syncfix/server && npm run typecheck -w @syncfix/client",
    "lint": "eslint .",
    "test": "npm run build:shared && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @syncfix/server",
    "db:migrate": "npm run db:migrate -w @syncfix/server",
    "db:seed": "npm run db:seed -w @syncfix/server",
    "dev:server": "npm run dev -w @syncfix/server",
    "dev:client": "npm run dev -w @syncfix/client",
    "dev:worker": "npm run worker -w @syncfix/server",
    "dev": "node scripts/dev.mjs",
    "start": "npm run start -w @syncfix/server",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}